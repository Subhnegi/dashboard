{
  "name": "businessflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BusinessFlow — SaaS Business Management Application",
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm run build -w server && npm run build -w client",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "server": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.x"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@vercel/node": "^24.0.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.14",
    "@rolldown/binding-linux-x64-musl": "1.2.14",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-x64-musl": "1.33.0"
  }
}
